DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
Options -Indexes

# Une seule adresse officielle : www -> sans www
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.itmdigitalcommunication\.com$ [NC]
RewriteRule ^(.*)$ https://itmdigitalcommunication.com/$1 [R=301,L]

# Ancienne adresse des actualités -> nouvelle rubrique
RedirectMatch 301 ^/actualites(/.*)?$ https://actualites.itmdigitalcommunication.com/

# Fichiers techniques non publics
<FilesMatch "(?i)^(README\.md|.*\.(py|sh|log|bak|sql))$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://actualites.itmdigitalcommunication.com; connect-src 'self' https://actualites.itmdigitalcommunication.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
</IfModule>
